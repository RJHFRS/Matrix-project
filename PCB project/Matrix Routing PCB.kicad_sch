	(text "Please note that in the schematic pin 1 is \nset floating as the document of the ftdi \ncable said not connect. Please confirm????"
		(exclude_from_sim no)
		(at 266.7 59.69 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 20 18 1)
			)
			(justify left)
		)
		(uuid "e6851333-c04c-461d-954c-08e349ca0333")
	)
	(text "USB OTG (On-The-Go) data lines require a 90-ohm (Ω) differential characteristic impedance with a standard tolerance of ± 10% to ± 15%.\nThe USB OTG has a different power net not connected to the 5V from the other 2 USBs. Please confirm."
		(exclude_from_sim no)
		(at 78.74 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 24 22 1)
			)
			(justify left)
