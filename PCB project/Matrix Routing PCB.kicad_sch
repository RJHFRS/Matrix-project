	(text ""
		(exclude_from_sim no)
		(at 172.72 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
			(href "https://ftdichip.com/wp-content/uploads/2020/08/DS_FT232R.pdf")
		)
		(uuid "4c1fff21-c425-4a0f-afb3-aad3b2787972")
	)
	(text "Confirmation notes:\n\n1) J2 pin 1 is floating.\n2) J2 pin 2 is TX for the connected board so FTDI RX is connected to it.\n3) J2 pin 3 is RX for the connected board so FTDI TX is connected ot it.\n4) USB OTG has a different VBUS power rail. The USB OTG has to\nwork as device so ID pin needs to be left floating. Please note\nthe ID pin is not fan out so it is floating."
		(exclude_from_sim no)
		(at 267.97 182.88 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left)
		)
		(uuid "6b29f990-802d-43af-92f3-6db2293d2c0c")
	)
	(text "USB touch"
		(exclude_from_sim no)
		(at 81.28 95.25 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6c17a71d-9182-4d0d-a485-3941b580378c")
	)
	(text "Page 9 CN5 table: Serial Port Connector\n1---+5V---+5V\n2---TX----Serial TX\n3---RX----Serial RX\n4---GND---Earth wire\nIt is assumed that TX in the table is the TX of the board \nand RX from FTDI needs to be connected. Please confirm.\nIt is assumed that RX in the table is the RX of hte board\nand TX from FTDI needs to be connected. Please confirm."
		(exclude_from_sim no)
		(at 260.35 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 255 27 50 1)
			)
			(justify left)
		)
		(uuid "724077a1-7240-4d27-a029-fdef8cec82e6")
	)
	(text "In the wiring list given in USB-TTL-31-V0 -20241203 \npin 1 is not connected.\nTo Be check and proceed accordijngly."
		(exclude_from_sim no)
		(at 168.91 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "761804b6-38bf-48dd-af33-28082983625a")
	)
	(text "CM3 IO USB connector female header on the adaptor  board"
		(exclude_from_sim no)
		(at 106.68 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7d777964-1a41-4377-9ff5-e20f2f71c27e")
	)
